#ifndef SLIM_COMMON_HTTP_HEADER_H
#define SLIM_COMMON_HTTP_HEADER_H
#include <array>
#include <cstdint>
#include <stdexcept>
#include <string>
#include <string_view>
#include <vector>
#include <slim/common/http/error_codes.h>
#define SLIMCOMMONHTTPHEADER_VERSION  "@SLIMCOMMONHTTPHEADER_VERSION@"
#define SLIMCOMMONHTTPHEADER_GIT_HASH "@SLIMCOMMONHTTPHEADER_GIT_HASH@"
namespace slim::common::http {
enum class HeaderType : uint8_t {
    Accept,
    AcceptCharset,
    AcceptEncoding,
    AcceptLanguage,
    Allow,
    CacheControl,
    Connection,
    ContentDisposition,
    ContentEncoding,
    ContentType,
    Forwarded,
    IfMatch,
    IfNoneMatch,
    Link,
    TransferEncoding,
    UserAgent,
    Vary,
    Via,
    XForwardedFor,
    Count
};
namespace header::type {
    constexpr std::array<std::string_view, static_cast<std::size_t>(HeaderType::Count)> delimiters = {
        ", ",  // Accept
        ", ",  // AcceptCharset
        ", ",  // AcceptEncoding
        ", ",  // AcceptLanguage
        ", ",  // Allow
        ", ",  // CacheControl
        ", ",  // Connection
        "; ",  // ContentDisposition
        ", ",  // ContentEncoding
        "; ",  // ContentType
        ", ",  // Forwarded
        ", ",  // IfMatch
        ", ",  // IfNoneMatch
        ", ",  // Link
        ", ",  // TransferEncoding
        " ",   // UserAgent
        ", ",  // Vary
        ", ",  // Via
        ", ",  // XForwardedFor
    };
    [[nodiscard]] constexpr std::string_view delimiter(HeaderType type) noexcept {
        const auto index = static_cast<std::size_t>(type);
        if (index < delimiters.size()) return delimiters[index];
        return {};
    }
} // namespace header::type
class Header {
public:
    Header() = default;
    Header(std::string_view name, std::string_view value, std::string delimiter = "");
    Header(const Header& other)            = delete;
    Header& operator=(const Header& other) = delete;
    Header(Header&& other) noexcept        = default;
    Header& operator=(Header&& other) noexcept = default;
    bool operator==(const Header& other) const noexcept;
    ~Header() = default;
    ErrorStatus              set_delimiter(std::string s) noexcept;
    ErrorStatus              set_name(std::string_view s) noexcept;
    std::string_view         get_name()  const noexcept { return name; }
    ErrorStatus              set_value(std::string_view s) noexcept;
    ErrorStatus              replace_value(std::string_view s) noexcept;
    std::vector<std::string>& get_value() noexcept { return values; }
    ErrorStatus              validate() const noexcept;
    std::string              serialize() const;
private:
    std::string              name;
    std::vector<std::string> values;
    std::string              delimiter{};
    friend class Response;
};
} // namespace slim::common::http
#endif // SLIM_COMMON_HTTP_HEADER_H
