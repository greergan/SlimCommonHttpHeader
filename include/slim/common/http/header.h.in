#ifndef SLIM_COMMON_HTTP_HEADER_H
#define SLIM_COMMON_HTTP_HEADER_H

#include <array>
#include <cstdint>
#include <stdexcept>
#include <string>
#include <string_view>
#include <vector>

#define SLIMCOMMONHTTPHEADER_VERSION  "@SLIMCOMMONHTTPHEADER_VERSION@"
#define SLIMCOMMONHTTPHEADER_GIT_HASH "@SLIMCOMMONHTTPHEADER_GIT_HASH@"

namespace slim::common::http {

enum class HeaderStatus : uint8_t {
    OK = 0,
    DelimiterInvalid,
    InvalidCookie,
    NameEmpty,
    NameInvalidChar,
    ValueEmpty,
    ValueInvalidChar,
    ValueInvalidFolding,
    Count
};

namespace header::status {
    constexpr std::array<std::string_view, static_cast<std::size_t>(HeaderStatus::Count)> strings = {
        "OK",                                                       // OK
        "Header delimiter is not valid",                            // DelimiterInvalid
        "Invalid cookie"                                            // InvalidCookie
        "Header name cannot be empty",                              // NameEmpty
        "Header name contains an invalid character",                // NameInvalidChar
        "Header value cannot be empty",                             // ValueEmpty
        "Header value contains an invalid character",               // ValueInvalidChar
        "Header value contains obsolete line folding (obs-fold)",   // ValueInvalidFolding
    };

    [[nodiscard]] constexpr std::string_view to_string(HeaderStatus status) noexcept {
        const auto index = static_cast<std::size_t>(status);
        if (index < strings.size()) return strings[index];
        return "Unknown";
    }
} // namespace header::status

enum class HeaderType : uint8_t {
    Accept,
    AcceptCharset,
    AcceptEncoding,
    AcceptLanguage,
    Allow,
    Authorization,
    CacheControl,
    Connection,
    ContentDisposition,
    ContentEncoding,
    ContentType,
    Forwarded,
    IfMatch,
    IfNoneMatch,
    Link,
    TransferEncoding,
    UserAgent,
    Vary,
    Via,
    Count
};

namespace header::type {
    constexpr std::array<std::string_view, static_cast<std::size_t>(HeaderType::Count)> delimiters = {
        ", ",  // Accept
        ", ",  // AcceptCharset
        ", ",  // AcceptEncoding
        ", ",  // AcceptLanguage
        ", ",  // Allow
        " ",   // Authorization
        ", ",  // CacheControl
        ", ",  // Connection
        "; ",  // ContentDisposition
        ", ",  // ContentEncoding
        "; ",  // ContentType
        ", ",  // Forwarded
        ", ",  // IfMatch
        ", ",  // IfNoneMatch
        ", ",  // Link
        ", ",  // TransferEncoding
        " ",   // UserAgent
        ", ",  // Vary
        ", ",  // Via
    };

    [[nodiscard]] constexpr std::string_view delimiter(HeaderType type) noexcept {
        const auto index = static_cast<std::size_t>(type);
        if (index < delimiters.size()) return delimiters[index];
        return {};
    }
} // namespace header::type

class HeaderException : public std::logic_error {
public:
    explicit HeaderException(HeaderStatus e)
        : std::logic_error("Invalid Header: " + std::string{header::status::to_string(e)}), status(e) {}

    explicit HeaderException(std::string msg) : std::logic_error(msg) {}

    HeaderStatus error() const noexcept { return status; }

private:
    HeaderStatus status = HeaderStatus::OK;
};

class Header {
public:
    Header() = default;
    Header(std::string_view name, std::string_view value, std::string delimiter = "");

    Header(const Header& other) = delete;
    Header& operator=(const Header& other) = delete;

    Header(Header&& other) noexcept = default;
    Header& operator=(Header&& other) noexcept = default;

    bool operator==(const Header& other) const noexcept;

    ~Header() = default;

    HeaderStatus set_delimiter(std::string s) noexcept;

    HeaderStatus set_name(std::string_view s) noexcept;
    std::string_view get_name() const noexcept { return name; }

    HeaderStatus set_value(std::string_view s) noexcept;
    HeaderStatus replace_value(std::string_view s) noexcept;
    const std::vector<std::string>& get_value() const noexcept { return values; }

    HeaderStatus validate() const noexcept;
    std::string serialize() const;

private:
    std::string name;
    std::vector<std::string> values;
    std::string delimiter = " ";
};

} // namespace slim::common::http

#endif // SLIM_COMMON_HTTP_HEADER_H
